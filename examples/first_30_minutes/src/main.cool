def total(items):
    sum = 0
    for item in items:
        sum += item
    return sum

def label(score):
    if score >= 90:
        return "excellent"
    if score >= 75:
        return "ready"
    return "warming up"

scores = [72, 88, 95]
average = total(scores) // len(scores)

print("Cool first 30 minutes")
print("scores: " + str(scores))
print("average: " + str(average))
print("status: " + label(average))
